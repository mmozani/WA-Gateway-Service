NODE_ENV=development

# HTTP server
HOST=127.0.0.1
PORT=30033

# Internal server-to-server authentication.
# Use at least 32 random characters.
API_TOKEN=replace-with-a-long-random-token-at-least-32-characters

# WhatsApp sessions
SESSION_IDS=primary

# Persistent WhatsApp Web authentication storage.
# Production target: /var/lib/wa-gateway/auth
WHATSAPP_AUTH_PATH=.wwebjs_auth

# Linked Device identity.
WHATSAPP_DEVICE_NAME=NeoZone OTP Gateway
WHATSAPP_BROWSER_NAME=Chrome

# Local Windows example:
# C:\Users\USERNAME\AppData\Local\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# Keep false whenever possible.
PUPPETEER_NO_SANDBOX=false

# Development linking.
# Production service should normally use false.
SHOW_QR_IN_TERMINAL=true

# WhatsApp send timeout
WHATSAPP_SEND_TIMEOUT_MS=8000

# Same phone+code+locale received again inside this window
# will NOT send a second WhatsApp message.
OTP_DEDUPE_WINDOW_MS=15000

# Gateway-wide protection.
# Business OTP limits remain the responsibility of NeoZoneCore.
OTP_GLOBAL_PER_MINUTE=60

DEBUG_MODE=true
